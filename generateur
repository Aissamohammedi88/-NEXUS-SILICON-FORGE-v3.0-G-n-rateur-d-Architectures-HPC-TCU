def safe_div(a, b, default=0.0):
return a / b if b else default


def compute_silicon(ax):
"""Calcul complet d'un chip à partir d'axiomes."""
# ─── Axiomes d'entrée ───
process_nm = int(ax.get("process_nm", 4))
sm_count = max(1, int(ax.get("sm_count", 132)))
freq_mhz = max(100.0, float(ax.get("freq_mhz", 1800)))
fma_per_sm = max(1, int(ax.get("fma_per_sm_cycle", 128)))
tensor_ratio = max(1.0, float(ax.get("tensor_ratio", 4.0)))
hbm_s = max(1, int(ax.get("hbm_stacks", 5)))
hbm_c = max(1, int(ax.get("hbm_channels", 16)))
hbm_w = max(32, int(ax.get("hbm_width_bits", 64)))
hbm_gt = max(0.5, float(ax.get("hbm_gt_s", 6.4)))
tdp_w = max(50, int(ax.get("tdp_w", 700)))
pcie_gen = max(3, int(ax.get("pcie_gen", 5)))
pcie_lanes = max(1, int(ax.get("pcie_lanes", 128)))
l2_kb = max(64, int(ax.get("l2_kb", 4096)))
noc = ax.get("noc_topology", "mesh")
nvlink_gb_s = max(0, float(ax.get("nvlink_gb_s", 900)))
sparsity = bool(ax.get("sparsity_enabled", False))
clock_gate = bool(ax.get("clock_gating", True))

# ─── Récupération paramètres technologiques ───
dens = DENSITE_NOEUD.get(process_nm, 100.0) # MTr/mm²
vdd = TENSION_NOEUD.get(process_nm, 0.7) # V
cout_wafer = COUT_WAFER.get(process_nm, 10000)
d0 = DENSITE_DEFAUTS.get(process_nm, 0.15)
freq_max = FREQ_MAX_NOEUD.get(process_nm, 5.0)

# ─── 1. Transistors (estimation) ───
# Modèle : chaque SM = fma_per_sm × K transistors + overhead contrôle
# FMA complexe ≈ 2000 transistors (multiplieur + additionneur + registres)
# On modélise par un facteur K calibré sur H100 (80e9 / 132 SM ≈ 606 MTr/SM)
K_TRANS_SM = 600.0 # MTr/SM (calibré H100)
trans_sm = sm_count * K_TRANS_SM # MTr
# HBM contrôleur : ~50 MTr par stack
trans_hbm = hbm_s * 50.0
# Interconnexion NoC : ~0.5 MTr/SM
trans_noc = sm_count * 0.5
# I/O + PCIe + L2 : ~0.2 MTr/SM
trans_io = sm_count * 0.2 + 100.0

transistors_mtr = trans_sm + trans_hbm + trans_noc + trans_io
transistors_b = transistors_mtr / 1000.0

# ─── 2. Die area ───
# Formule : A = N_transistors / Densité
die_mm2 = transistors_mtr / dens if dens > 0 else 0.0

# ─── 3. Wafer 300mm ───
wafer_diameter_mm = 300
wafer_area_mm2 = math.pi * (wafer_diameter_mm / 2.0) ** 2
# Nombre de dies par wafer (formule de la surface utile)
# N = π × (D/2)² / A - π × D / √(2A) (approximation conventionnelle)
dies_per_wafer = max(1, int(wafer_area_mm2 / die_mm2 -
math.pi * wafer_diameter_mm / math.sqrt(2 * die_mm2)))

# ─── 4. Yield (modèle binomial négatif Murphy) ───
# Y = (1 + A × D₀ / n)^(-n)
n_cluster = 4.0 # facteur de clustering
yield_pct = safe_div(1.0, (1.0 + (die_mm2 * d0 / 100.0) / n_cluster) ** n_cluster) * 100.0
yield_pct = max(0.1, min(99.9, yield_pct))

# ─── 5. Coût par die ───
cost_per_die = cout_wafer / max(1, dies_per_wafer * yield_pct / 100.0)

# ─── 6. Calcul (TFLOPS) ───
# FMA = 2 opérations (mult + add)
flops_fp16 = 2.0 * fma_per_sm * sm_count * (freq_mhz * 1e6) * tensor_ratio
tflops_fp16 = flops_fp16 / 1e12
tflops_fp8 = tflops_fp16 * 2.0
tflops_int8 = tflops_fp16 * 2.0
sf = 2.0 if sparsity else 1.0
tflops_fp16_s = tflops_fp16 * sf
tflops_fp8_s = tflops_fp8 * sf

# ─── 7. Mémoire HBM ───
bw_bits_s = hbm_s * hbm_c * hbm_w * hbm_gt * 1e9
bw_gb_s = bw_bits_s / 8.0 / 1e9
bw_tb_s = bw_gb_s / 1000.0
hbm_gb = hbm_s * 16.0 # 16 GB/stack
hbm_energy_pj_per_bit = 5.0 # pJ/bit (typique HBM3)

# ─── 8. PCIe ───
pcie_gt = {3: 8.0, 4: 16.0, 5: 32.0, 6: 64.0}.get(pcie_gen, 32.0)
pcie_bw = (pcie_lanes * pcie_gt * 1e9) / 8.0 / 1e9 * 0.985

# ─── 9. Roofline ───
ridge = safe_div(tflops_fp16 * 1e12, bw_gb_s * 1e9)
if ridge < 50:
regime = "memory-bound"
elif ridge < 200:
regime = "balanced"
else:
regime = "compute-bound"

# ─── 10. Puissance (P = α × C × V² × f + P_static) ───
# Capacité totale (F) : approximation = 0.5 fF par transistor
cap_per_transistor = 0.5e-15 # F
cap_total = transistors_mtr * 1e6 * cap_per_transistor # F
alpha_dyn = 0.15 if clock_gate else 0.30 # activité
freq_hz = freq_mhz * 1e6
p_dynamic = alpha_dyn * cap_total * (vdd ** 2) * freq_hz

# Puissance statique (fuite)
i_leak_per_sm = 0.5 # A par SM (typique)
p_static = sm_count * i_leak_per_sm * vdd * 0.1 # Ajusté

# Puissance mémoire
p_memory = hbm_s * 5.0 # W par stack HBM3

# Puissance I/O
p_io = safe_div(pcie_lanes, 16) * 2.0 # W

p_total = p_dynamic + p_static + p_memory + p_io

# ─── 11. Thermique ───
# T_j = T_a + P × R_th
t_ambient = 25.0 # °C
r_th_jc = 0.05 # °C/W (junction-case)
r_th_heatsink = safe_div(0.3, 1.0) # °C/W
t_junction = t_ambient + tdp_w * (r_th_jc + r_th_heatsink)

# ─── 12. Efficacité ───
tpw_fp16 = safe_div(tflops_fp16, tdp_w)
tpw_fp8 = safe_div(tflops_fp8, tdp_w)
tpw_fp16_sparse = safe_div(tflops_fp16_s, tdp_w)

# ─── 13. Energy per operation ───
# E = P / ops_per_second
ops_fp16_per_sec = tflops_fp16 * 1e12
energy_fp16_pj = safe_div(tdp_w, ops_fp16_per_sec) * 1e12
ops_fp8_per_sec = tflops_fp8 * 1e12
energy_fp8_pj = safe_div(tdp_w, ops_fp8_per_sec) * 1e12

# ─── 14. Cache hierarchy ───
l1_kb = 256 * sm_count
l2_total_kb = l2_kb
l2_per_sm_kb = safe_div(l2_kb, sm_count)
cache_ratio = safe_div(l2_kb * 1024, bw_gb_s * 1e9) # secondes pour remplir

# ─── 15. Comparaison avec références ───
comparisons = {}
for key, ref in REFERENCES.items():
ref_tf = ref.get("tflops_fp16_dense", 0)
ref_bw = ref.get("bw_gb_s", 0)
ref_tdp = ref.get("tdp_w", 1)
ref_eff = safe_div(ref_tf, ref_tdp)

d_tf = safe_div(tflops_fp16 - ref_tf, ref_tf) * 100.0
d_bw = safe_div(bw_gb_s - ref_bw, ref_bw) * 100.0
d_eff = safe_div(tpw_fp16 - ref_eff, ref_eff) * 100.0

if d_tf > 0 and d_bw > 0:
verdict = "SUPERIEUR"
elif d_tf < 0 and d_bw < 0:
verdict = "INFERIEUR"
elif d_tf > 0:
verdict = "PLUS_DE_CALCUL"
else:
verdict = "PLUS_DE_MEMOIRE"

comparisons[key] = {
"nom": ref["nom"],
"annee": ref["annee"],
"arch": ref["arch"],
"process_nm": ref["process_nm"],
"tflops_ref": ref_tf,
"bw_ref": ref_bw,
"tdp_ref": ref_tdp,
"delta_tflops_pct": round(d_tf, 1),
"delta_bw_pct": round(d_bw, 1),
"delta_efficiency_pct": round(d_eff, 1),
"verdict": verdict,
}

# ─── 16. Bottlenecks honnêtes ───
bottlenecks = []
if ridge < 50:
bottlenecks.append({
"type": "memoire", "priority": "haute",
"message": "Ridge bas ({:.0f} op/byte) → HBM saturée avant le calcul".format(ridge),
})
elif ridge > 200:
bottlenecks.append({
"type": "calcul", "priority": "haute",
"message": "Ridge haut ({:.0f} op/byte) → mémoire sous-utilisée".format(ridge),
})
if tpw_fp16 < 1.0:
bottlenecks.append({
"type": "efficacite", "priority": "haute",
"message": "TFLOPS/W faible ({:.2f}) → revoir tension/fréquence".format(tpw_fp16),
})
if pcie_bw < bw_gb_s * 0.1:
bottlenecks.append({
"type": "interconnexion", "priority": "moyenne",
"message": "PCIe ({:.0f} GB/s) << HBM ({:.0f} GB/s)".format(pcie_bw, bw_gb_s),
})
if t_junction > 100:
bottlenecks.append({
"type": "thermique", "priority": "haute",
"message": "T_junction = {:.0f}°C → besoin refroidissement liquide".format(t_junction),
})
if yield_pct < 50:
bottlenecks.append({
"type": "rendement", "priority": "haute",
"message": "Yield faible ({:.1f}%) → coût par die élevé ({:.0f} USD)".format(
yield_pct, cost_per_die),
})
if l2_kb < sm_count * 32:
bottlenecks.append({
"type": "cache", "priority": "moyenne",
"message": "L2 faible ({:.1f} KB/SM) → bande passante insuffisante".format(l2_per_sm_kb),
})
if freq_mhz > freq_max * 1000:
bottlenecks.append({
"type": "frequence", "priority": "haute",
"message": "Fréquence ({:.0f} MHz) > max nœud ({:.0f} MHz) → instable".format(
freq_mhz, freq_max * 1000),
})

# ─── 17. Résultat complet ───
return {
"version": VERSION,
"axiomes": {
"process_nm": process_nm, "sm_count": sm_count,
"freq_mhz": freq_mhz, "fma_per_sm_cycle": fma_per_sm,
"tensor_ratio": tensor_ratio, "hbm_stacks": hbm_s,
"hbm_channels": hbm_c, "hbm_width_bits": hbm_w,
"hbm_gt_s": hbm_gt, "tdp_w": tdp_w, "pcie_gen": pcie_gen,
"pcie_lanes": pcie_lanes, "l2_kb": l2_kb,
"noc_topology": noc, "nvlink_gb_s": nvlink_gb_s,
"sparsity_enabled": sparsity, "clock_gating": clock_gate,
},
"technologie": {
"process_nm": process_nm,
"densite_mtr_mm2": dens,
"vdd_v": vdd,
"cout_wafer_usd": cout_wafer,
"densite_defauts_cm2": d0,
"freq_max_ghz": freq_max,
},
"transistors": {
"total_b": round(transistors_b, 1),
"par_sm_mtr": round(K_TRANS_SM, 1),
"sm_mtr": round(trans_sm, 1),
"hbm_mtr": round(trans_hbm, 1),
"noc_mtr": round(trans_noc, 1),
"io_mtr": round(trans_io, 1),
"formule": "N_transistors = Σ (SM × K_TRANS_SM + HBM + NoC + I/O)",
},
"die": {
"area_mm2": round(die_mm2, 1),
"dies_per_wafer": dies_per_wafer,
"yield_pct": round(yield_pct, 1),
"cost_per_die_usd": round(cost_per_die, 2),
"wafer_diameter_mm": wafer_diameter_mm,
"formule_yield": "Y = (1 + A × D₀ / n)^(-n)",
},
"calcul": {
"tflops_fp16_dense": round(tflops_fp16, 1),
"tflops_fp8_dense": round(tflops_fp8, 1),
"tflops_int8_dense": round(tflops_int8, 1),
"tflops_fp16_sparse": round(tflops_fp16_s, 1),
"tflops_fp8_sparse": round(tflops_fp8_s, 1),
"formule": "TFLOPS = 2 × FMA × SM × freq_GHz × tensor_ratio",
},
"memoire": {
"bw_gb_s": round(bw_gb_s, 1),
