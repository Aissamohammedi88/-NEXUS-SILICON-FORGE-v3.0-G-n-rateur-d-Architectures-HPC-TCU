# ═══════════════════════════════════════════════════════════════════════════
# HTTP HANDLER
# ═══════════════════════════════════════════════════════════════════════════
class Handler(BaseHTTPRequestHandler):

def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8"):
if isinstance(body, str):
body = body.encode("utf-8")
try:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
self.wfile.write(body)
except Exception:
pass

def _json(self, data, code=200):
self._send(code, json.dumps(data, ensure_ascii=False, default=str),
"application/json; charset=utf-8")

def do_GET(self):
path = urllib.parse.urlparse(self.path).path

if path in ("/", "/index.html"):
self._send(200, HTML_PAGE)
elif path == "/api/references":
self._json(REFERENCES)
elif path == "/api/projects":
items = []
for d in PROJECTS.iterdir():
if d.is_dir():
items.append({"name": d.name})
self._json(items)
elif path.startswith("/api/download/"):
chip = path.split("/")[-1]
proj = PROJECTS / chip
if not proj.exists() or not proj.is_dir():
self._send(404, "Projet introuvable")
return
try:
data = zip_projet(proj)
self.send_response(200)
self.send_header("Content-Type", "application/zip")
self.send_header(
"Content-Disposition",
'attachment; filename="' + chip + '.zip"'
)
self.send_header("Content-Length", str(len(data)))
self.end_headers()
self.wfile.write(data)
except Exception as e:
self._send(500, "Erreur ZIP : " + str(e))
else:
self._send(404, "Not found")

def do_POST(self):
path = urllib.parse.urlparse(self.path).path
try:
n = int(self.headers.get("Content-Length", 0))
body = self.rfile.read(n).decode("utf-8") if n else "{}"
data = json.loads(body) if body else {}
except Exception:
data = {}

if path == "/api/compute":
try:
self._json(compute_silicon(data))
except Exception as e:
self._json({"error": str(e)}, 500)

elif path == "/api/generate":
chip = data.get("chip", "nexus_n1")
ax = data.get("axiomes", {})
try:
proj, files, model = generer_projet(chip, ax)
self._json({
"chip": chip,
"chemin": str(proj),
"files": files,
})
except Exception as e:
self._json({"error": str(e)}, 500)

elif path.startswith("/api/simulate/"):
chip = path.split("/")[-1]
proj = PROJECTS / chip
if not proj.exists():
self._json({"error": "Projet introuvable"}, 404)
return
self._json(run_simulation(proj, chip))

elif path.startswith("/api/synthesize/"):
chip = path.split("/")[-1]
proj = PROJECTS / chip
if not proj.exists():
self._json({"error": "Projet introuvable"}, 404)
return
self._json(run_synthesis(proj, chip))

else:
self._json({"error": "not found"}, 404)


