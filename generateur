def gen_verilog_top(chip, ax):
return """// ═══════════════════════════════════════════════════════════════════════════
// {chip}_top — NEXUS SILICON STUDIO v{ver}
// Author : {author}
// Date : {date}
// ═══════════════════════════════════════════════════════════════════════════
`timescale 1ns / 1ps

module {chip}_top #(
parameter SM_COUNT = {sm},
parameter FMA_PER_SM = {fma},
parameter TENSOR_RATIO = {tensor},
parameter HBM_STACKS = {hbm_s},
parameter HBM_CHANNELS = {hbm_c},
parameter HBM_WIDTH_BITS = {hbm_w},
parameter PCIE_LANES = {pcie_lanes},
parameter L2_KB = {l2}
)(
input wire clk,
input wire rst_n,
input wire start,
output wire done,
output wire [31:0] cycle_count,
output wire [31:0] ops_counter,
output wire [15:0] busy_sm_mask,
output wire hbm_ready,
output wire pcie_up
);

wire cluster_done;
wire [31:0] cluster_ops;
wire hbm_ready_i;

{chip}_cluster #(
.SM_COUNT(SM_COUNT),
.FMA_PER_SM(FMA_PER_SM),
.TENSOR_RATIO(TENSOR_RATIO)
) u_cluster (
.clk(clk),
.rst_n(rst_n),
.enable(start),
.busy_mask(busy_sm_mask),
.ops_out(cluster_ops),
.done(cluster_done)
);

{chip}_hbm_ctrl #(
.HBM_STACKS(HBM_STACKS),
.HBM_CHANNELS(HBM_CHANNELS),
.HBM_WIDTH_BITS(HBM_WIDTH_BITS)
) u_hbm (
.clk(clk),
.rst_n(rst_n),
.req(start),
.ready(hbm_ready_i)
);

{chip}_pcie #(
.PCIE_LANES(PCIE_LANES)
) u_pcie (
.clk(clk),
.rst_n(rst_n),
.link_up(pcie_up)
);

reg [31:0] cycles;
reg running;
always @(posedge clk or negedge rst_n) begin
if (!rst_n) begin
cycles <= 32'd0;
running <= 1'b0;
end else begin
if (start && !running) begin
running <= 1'b1;
cycles <= 32'd0;
end else if (running) begin
cycles <= cycles + 32'd1;
if (cycles >= 32'd1000) running <= 1'b0;
end
end
end

assign cycle_count = cycles;
assign ops_counter = cluster_ops;
assign done = (cycles >= 32'd1000);
assign hbm_ready = hbm_ready_i;

endmodule
""".format(
chip=chip, ver=VERSION, author=AUTEUR,
date=datetime.now().isoformat(),
sm=ax.get("sm_count", 132),
fma=ax.get("fma_per_sm_cycle", 128),
tensor=ax.get("tensor_ratio", 4.0),
hbm_s=ax.get("hbm_stacks", 5),
hbm_c=ax.get("hbm_channels", 16),
hbm_w=ax.get("hbm_width_bits", 64),
pcie_lanes=ax.get("pcie_lanes", 128),
l2=ax.get("l2_kb", 4096),
)


def gen_verilog_cluster(chip, ax):
return """// ═══════════════════════════════════════════════════════════════════════════
// {chip}_cluster — Cluster de SMs
// ═══════════════════════════════════════════════════════════════════════════
`timescale 1ns / 1ps

module {chip}_cluster #(
parameter SM_COUNT = {sm},
parameter FMA_PER_SM = {fma},
parameter TENSOR_RATIO = {tensor}
)(
input wire clk,
input wire rst_n,
input wire enable,
output wire [15:0] busy_mask,
output reg [31:0] ops_out,
output reg done
);

localparam OPS_PER_CYCLE = FMA_PER_SM;
localparam MAX_SM = 16;

reg [15:0] active_sm;
reg [31:0] ops_acc;

always @(posedge clk or negedge rst_n) begin
if (!rst_n) begin
active_sm <= 16'd0;
ops_acc <= 32'd0;
ops_out <= 32'd0;
done <= 1'b0;
end else if (enable) begin
if (active_sm < SM_COUNT[15:0] && active_sm < MAX_SM[15:0])
active_sm <= active_sm + 16'd1;
ops_acc <= ops_acc + (active_sm[15:0] * OPS_PER_CYCLE[15:0]);
ops_out <= ops_acc;
done <= (ops_acc >= 32'hFFFFFF);
end else begin
active_sm <= 16'd0;
done <= 1'b0;
end
end

assign busy_mask = active_sm;

endmodule
""".format(
chip=chip,
sm=ax.get("sm_count", 132),
fma=ax.get("fma_per_sm_cycle", 128),
tensor=ax.get("tensor_ratio", 4.0),
)


def gen_verilog_hbm(chip, ax):
return """// ═══════════════════════════════════════════════════════════════════════════
// {chip}_hbm_ctrl — Contrôleur HBM simplifié
// ═══════════════════════════════════════════════════════════════════════════
`timescale 1ns / 1ps

module {chip}_hbm_ctrl #(
parameter HBM_STACKS = {hbm_s},
parameter HBM_CHANNELS = {hbm_c},
parameter HBM_WIDTH_BITS = {hbm_w}
)(
input wire clk,
input wire rst_n,
input wire req,
output reg ready
);

localparam TOTAL_CHANNELS = HBM_STACKS * HBM_CHANNELS;

reg [15:0] req_count;
reg [7:0] ch_sel;

always @(posedge clk or negedge rst_n) begin
if (!rst_n) begin
req_count <= 16'd0;
ch_sel <= 8'd0;
ready <= 1'b0;
end else if (req) begin
req_count <= req_count + 16'd1;
ch_sel <= ch_sel + 8'd1;
if (ch_sel >= TOTAL_CHANNELS[7:0]) ch_sel <= 8'd0;
ready <= (req_count[3:0] == 4'hF);
end else begin
req_count <= 16'd0;
ready <= 1'b0;
end
end

endmodule
""".format(
chip=chip,
hbm_s=ax.get("hbm_stacks", 5),
hbm_c=ax.get("hbm_channels", 16),
hbm_w=ax.get("hbm_width_bits", 64),
)


def gen_verilog_pcie(chip, ax):
return """// ═══════════════════════════════════════════════════════════════════════════
// {chip}_pcie — Stub LTSSM
// ═══════════════════════════════════════════════════════════════════════════
`timescale 1ns / 1ps

module {chip}_pcie #(
parameter PCIE_LANES = {pcie_lanes}
)(
input wire clk,
input wire rst_n,
output reg link_up
);

reg [5:0] cnt;

always @(posedge clk or negedge rst_n) begin
if (!rst_n) begin
cnt <= 6'd0;
link_up <= 1'b0;
end else if (cnt < 6'd63) begin
cnt <= cnt + 6'd1;
link_up <= 1'b0;
end else begin
link_up <= 1'b1;
end
end

endmodule
""".format(chip=chip, pcie_lanes=ax.get("pcie_lanes", 128))


