def run_simulation(proj, chip):
out = {
"iverilog_available": False,
"yosys_available": False,
"sim_output": "",
"sim_success": False,
"error": "",
}
iverilog = shutil.which("iverilog")
vvp = shutil.which("vvp")
yosys = shutil.which("yosys")

out["iverilog_available"] = bool(iverilog and vvp)
out["yosys_available"] = bool(yosys)

if not out["iverilog_available"]:
out["error"] = "iverilog/vvp non installés"
return out

rtl = sorted((proj / "rtl").glob("*.v"))
tb = sorted((proj / "tb").glob("*.v"))

if not rtl or not tb:
out["error"] = "Fichiers RTL/TB manquants"
return out

try:
cmd = [iverilog, "-g2012", "-o", "sim.vvp"]
cmd.extend(str(f) for f in rtl)
cmd.extend(str(f) for f in tb)
r = subprocess.run(cmd, cwd=str(proj), capture_output=True,
text=True, timeout=30)
if r.returncode != 0:
out["error"] = "iverilog: " + (r.stderr[:500] or r.stdout[:500])
return out
r2 = subprocess.run([vvp, "sim.vvp"], cwd=str(proj),
capture_output=True, text=True, timeout=30)
out["sim_output"] = (r2.stdout or "") + (r2.stderr or "")
out["sim_success"] = "PASS" in out["sim_output"]
except subprocess.TimeoutExpired:
out["error"] = "Timeout simulation"
except Exception as e:
out["error"] = str(e)
return out


def run_synthesis(proj, chip):
out = {"synth_success": False, "synth_output": "", "error": ""}
yosys = shutil.which("yosys")
if not yosys:
out["error"] = "yosys non installé"
return out
rtl = sorted((proj / "rtl").glob("*.v"))
try:
script = "read_verilog " + " ".join(str(f) for f in rtl)
script += "; hierarchy -top {}_top; proc; opt; stat".format(chip)
r = subprocess.run([yosys, "-p", script], cwd=str(proj),
capture_output=True, text=True, timeout=60)
out["synth_output"] = (r.stdout or "") + (r.stderr or "")
out["synth_success"] = r.returncode == 0
except Exception as e:
out["error"] = str(e)
return out


def zip_projet(proj):
buf = io.BytesIO()
with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as zf:
for f in proj.rglob("*"):
if f.is_file():
zf.write(f, str(f.relative_to(proj)))
return buf.getvalue()


