def generer_projet(chip, ax):
chip = re.sub(r"[^a-zA-Z0-9_]", "_", chip)
proj = PROJECTS / chip
proj.mkdir(parents=True, exist_ok=True)

files = {
"rtl/{0}_top.v".format(chip): gen_verilog_top(chip, ax),
"rtl/{0}_cluster.v".format(chip): gen_verilog_cluster(chip, ax),
"rtl/{0}_hbm_ctrl.v".format(chip): gen_verilog_hbm(chip, ax),
"rtl/{0}_pcie.v".format(chip): gen_verilog_pcie(chip, ax),
"tb/tb_{0}_top.v".format(chip): gen_testbench(chip, ax),
"Makefile": gen_makefile(chip),
"README.md": gen_readme(chip, ax),
}

written = []
for rel, content in files.items():
full = proj / rel
full.parent.mkdir(parents=True, exist_ok=True)
full.write_text(content, encoding="utf-8")
written.append({
"path": rel,
"lines": content.count("\n") + 1,
"size": len(content),
})

model = compute_silicon(ax)
(proj / "model.json").write_text(
json.dumps(model, indent=2, ensure_ascii=False), encoding="utf-8"
)
(proj / "config.json").write_text(
json.dumps({"chip": chip, "axiomes": ax,
"date": datetime.now().isoformat()},
indent=2, ensure_ascii=False),
encoding="utf-8"
)

return proj, written, model


