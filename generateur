async function compute() {
const ax = getAx();
document.getElementById('results-out').innerHTML =
'<p style="color:var(--warn)">Calcul en cours...</p>';
try {
const r = await fetch('/api/compute', {
method: 'POST',
headers: {'Content-Type': 'application/json'},
body: JSON.stringify(ax)
});
const m = await r.json();
if (m.error) {
document.getElementById('results-out').innerHTML =
'<p style="color:var(--danger)">' + m.error + '</p>';
return;
}
displayResults(m);
} catch(e) {
document.getElementById('results-out').innerHTML =
'<p style="color:var(--danger)">Erreur : ' + e.message + '</p>';
}
}

function metric(lbl, val, unit) {
return '<div class="metric"><div class="lbl">' + lbl + '</div>' +
'<div class="val">' + val +
(unit ? '<span class="unit">' + unit + '</span>' : '') +
'</div></div>';
}

function displayResults(m) {
let html = '';

html += '<h3>Technologie (' + m.technologie.process_nm + ' nm)</h3>';
html += '<div class="metrics">';
html += metric('Densité', m.technologie.densite_mtr_mm2, 'MTr/mm²');
html += metric('Tension', m.technologie.vdd_v, 'V');
html += metric('Coût wafer', m.technologie.cout_wafer_usd, 'USD');
html += metric('Fréq max', m.technologie.freq_max_ghz, 'GHz');
html += '</div>';

html += '<h3>Transistors</h3>';
html += '<div class="metrics">';
html += metric('Total', m.transistors.total_b, 'milliards');
html += metric('Par SM', m.transistors.par_sm_mtr, 'MTr/SM');
html += metric('SM', m.transistors.sm_mtr, 'MTr');
html += metric('HBM', m.transistors.hbm_mtr, 'MTr');
html += '</div>';

html += '<h3>Die et rendement</h3>';
html += '<div class="metrics">';
html += metric('Surface', m.die.area_mm2, 'mm²');
html += metric('Dies/wafer', m.die.dies_per_wafer, 'unités');
html += metric('Yield', m.die.yield_pct, '%');
html += metric('Coût/die', m.die.cost_per_die_usd, 'USD');
html += '</div>';

html += '<h3>Calcul</h3>';
html += '<div class="metrics">';
html += metric('FP16 dense', m.calcul.tflops_fp16_dense, 'TFLOPS');
html += metric('FP8 dense', m.calcul.tflops_fp8_dense, 'TFLOPS');
html += metric('INT8', m.calcul.tflops_int8_dense, 'TOPS');
html += metric('FP16 sparse', m.calcul.tflops_fp16_sparse, 'TFLOPS');
html += '</div>';

html += '<h3>Mémoire</h3>';
html += '<div class="metrics">';
html += metric('BW', m.memoire.bw_gb_s, 'GB/s');
html += metric('Capacité', m.memoire.capacite_gb, 'GB');
html += metric('Énergie', m.memoire.energie_pj_par_bit, 'pJ/bit');
html += metric('BW', m.memoire.bw_tb_s, 'TB/s');
html += '</div>';

html += '<h3>Puissance (P = αCV²f + IV)</h3>';
html += '<div class="metrics">';
html += metric('Dynamique', m.puissance.p_dynamic_w, 'W');
html += metric('Statique', m.puissance.p_static_w, 'W');
html += metric('Mémoire', m.puissance.p_memory_w, 'W');
html += metric('I/O', m.puissance.p_io_w, 'W');
html += metric('Total', m.puissance.p_total_w, 'W');
html += metric('TDP cible', m.puissance.tdp_w, 'W');
html += '</div>';

html += '<h3>Thermique (T_j = T_a + P·R_th)</h3>';
html += '<div class="metrics">';
html += metric('T ambient', m.thermique.t_ambient_c, '°C');
html += metric('T junction', m.thermique.t_junction_c, '°C');
html += metric('R_th j-c', m.thermique.r_th_jc_cw, '°C/W');
html += metric('Refroidissement', m.thermique.refroidissement, '');
html += '</div>';

html += '<h3>Efficacité</h3>';
html += '<div class="metrics">';
html += metric('FP16', m.efficacite.tflops_per_watt_fp16, 'TFLOPS/W');
html += metric('FP8', m.efficacite.tflops_per_watt_fp8, 'TFLOPS/W');
html += metric('Énergie FP16', m.efficacite.energy_fp16_pj, 'pJ/op');
html += metric('Énergie FP8', m.efficacite.energy_fp8_pj, 'pJ/op');
html += '</div>';

html += '<h3>Roofline</h3>';
html += '<div class="metrics">';
html += metric('Ridge', m.roofline.ridge_op_per_byte, 'op/byte');
html += metric('Régime', m.roofline.regime, '');
html += '</div>';

html += '<h3>Bottlenecks identifiés</h3>';
if (m.bottlenecks.length === 0) {
html += '<p style="color:var(--success)">Aucun bottleneck critique</p>';
} else {
m.bottlenecks.forEach(b => {
html += '<div class="bottleneck ' + b.priority + '">';
html += '<div class="type">' + b.type + ' · ' + b.priority + '</div>';
html += '<div>' + b.message + '</div>';
html += '</div>';
});
}

html += '<h3>Comparaison NVIDIA / AMD / Google</h3>';
html += '<table><thead><tr>';
html += '<th>Référence</th><th>ΔTFLOPS</th><th>ΔBW</th><th>ΔEff</th><th>Verdict</th>';
html += '</tr></thead><tbody>';
for (const [k, v] of Object.entries(m.comparaison)) {
let cls = 'neu';
if (v.verdict === 'SUPERIEUR') cls = 'ok';
if (v.verdict === 'INFERIEUR') cls = 'ko';
html += '<tr>';
html += '<td>' + v.nom + ' (' + v.annee + ')</td>';
html += '<td>' + (v.delta_tflops_pct > 0 ? '+' : '') + v.delta_tflops_pct + '%</td>';
html += '<td>' + (v.delta_bw_pct > 0 ? '+' : '') + v.delta_bw_pct + '%</td>';
html += '<td>' + (v.delta_efficiency_pct > 0 ? '+' : '') + v.delta_efficiency_pct + '%</td>';
html += '<td class="' + cls + '">' + v.verdict + '</td>';
html += '</tr>';
}
html += '</tbody></table>';

document.getElementById('results-out').innerHTML = html;
}

