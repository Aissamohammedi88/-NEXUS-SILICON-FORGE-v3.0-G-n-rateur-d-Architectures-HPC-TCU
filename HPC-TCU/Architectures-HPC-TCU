            "COMPARE_TABLE": _compare_table(spec["compare"]),

        }),

    }

    return files, name





def _noc_route_logic(topo, ports_var):

    if topo == "ring":

        return "for (int i=0;i<PORTS;i++) route_grant[i] = links[i*64] && links[((i+1)%PORTS)*64];"

    if topo == "crossbar":

        return "for (int i=0;i<PORTS;i++) route_grant[i] = |links[i*64 +: 64];"

    # mesh (défaut)

    return "for (int i=0;i<PORTS;i++) route_grant[i] = links[i*64] ^ links[(i^1)*64 % PORTS];"





def _hbm_placement(stacks, dw, dh):

    lines = []

    per_side = max(1, stacks // 4)

    for i in range(stacks):

        side = i % 4

        x = {0: "0.05", 1: f"{dw-0.5}", 2: "0.05", 3: f"{dw-0.5}"}[side]

        y = {0: f"{dh-0.5}", 1: "0.05", 2: "0.05", 3: f"{dh-0.5}"}[side]

        lines.append(f"place_inst u_hbm_stack{i} -loc {{{x} {y}}}")

    return "\n".join(lines)





def _compare_table(compare):

    rows = []

    for k, v in compare.items():

        rows.append(f"| {v['nom']} | {v['delta_tflops_pct']:+.1f}% | {v['delta_bw_pct']:+.1f}% | **{v['verdict']}** |")

    return "\n".join(rows)





