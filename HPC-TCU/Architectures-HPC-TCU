class Handler(BaseHTTPRequestHandler):

    def log_message(self, *a): pass



    def _send(self, code, body, ctype="text/html; charset=utf-8"):

        if isinstance(body, str): body = body.encode("utf-8")

        self.send_response(code)

        self.send_header("Content-Type", ctype)

        self.send_header("Content-Length", str(len(body)))

        self.send_header("Access-Control-Allow-Origin", "*")

        self.end_headers()

        try: self.wfile.write(body)

        except Exception: pass



    def _json(self, data, code=200):

        self._send(code, json.dumps(data, ensure_ascii=False, default=str), "application/json; charset=utf-8")



    def do_GET(self):

        path = urllib.parse.urlparse(self.path).path

        if path in ("/", "/index.html"):

            self._send(200, HTML)

        elif path == "/api/references":

            self._json(REFERENCES)

        elif path == "/api/health":

            self._json({"ok": True, "version": "3.0", "engine": "NEXUS SILICON FORGE",

                        "references": list(REFERENCES.keys()),

                        "gamma_half": GAMMA_HALF, "zeta_apery": ZETA_APERY})

        elif path.startswith("/api/download/"):

            nom = urllib.parse.unquote(path.split("/")[-1])

            pd = PROJECTS_DIR / nom

            if not pd.exists(): self._send(404, "Projet introuvable"); return

            buf = io.BytesIO()

            with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as zf:

                for f in pd.rglob("*"):

                    if f.is_file(): zf.write(f, f.relative_to(pd))

            body = buf.getvalue()

            self.send_response(200)

            self.send_header("Content-Type", "application/zip")

            self.send_header("Content-Disposition", f'attachment; filename="{nom}.zip"')

            self.send_header("Content-Length", str(len(body)))

            self.end_headers(); self.wfile.write(body)

        else:

            self._send(404, "Not found")



    def do_POST(self):

        path = urllib.parse.urlparse(self.path).path

        ln = int(self.headers.get("Content-Length", 0))

        raw = self.rfile.read(ln).decode("utf-8") if ln else "{}"

        try: ax = json.loads(raw)

        except Exception: ax = {}

        if path == "/api/forge":

            try:

                spec = derive_spec(ax)

                proj_name = ax.get("nom", "forge")

                pd, files, total_lines, chip = generate_project(spec, proj_name)

                # arbre hiérarchique lisible

                tree = (f"{chip}_top\n"

                        f"├─ {chip}_noc ({spec['noc']['topology']} radix {spec['noc']['radix']})\n"

                        f"├─ {spec['clusters']}× {chip}_cluster\n"

                        f"│   └─ {max(1,spec['sm_count']//spec['clusters'])}× {chip}_sm\n"

                        f"│       ├─ {chip}_tensor_core ({spec['tensor']['m']}×{spec['tensor']['n']}×{spec['tensor']['k']})\n"

                        f"│       └─ L1 {spec['cache']['l1_kb']} KB\n"

                        f"├─ {chip}_hbm_ctrl ({spec['hbm']['stacks']} stacks)\n"

                        f"├─ {chip}_pcie (Gen{spec['pcie']['gen']} x{spec['pcie']['lanes']})\n"

                        + (f"├─ {chip}_dvfs (4 phases)\n" if spec['dvfs'] else "")

