)(

    input  wire clk, input  wire rst_n,

    input  wire [LANES-1:0] rxp, rxn,

    output wire [LANES-1:0] txp, txn,

    input  wire [63:0] host_cmd,

    output wire [63:0] host_status,

    inout  wire [63:0] noc

);

  // LTSSM : Detect→Polling→Configuration→L0

  typedef enum logic [3:0] {

    DETECT, POLL_ACTIVE, POLL_CFG, CFG_LINKWD, CFG_LANENUM,

    CFG_COMPLETE, HOT_RESET, RECOVERY, L0, L0S, L1, L2

  } ltssm_e;

  ltssm_e state, next_state;



  always_ff @(posedge clk or negedge rst_n) begin

    if (!rst_n) state <= DETECT;

    else state <= next_state;

  end

  always_comb begin

    next_state = state;

    case (state)

      DETECT:      next_state = POLL_ACTIVE;

      POLL_ACTIVE: next_state = POLL_CFG;

      POLL_CFG:    next_state = CFG_LINKWD;

      CFG_LINKWD:  next_state = CFG_LANENUM;

      CFG_LANENUM: next_state = CFG_COMPLETE;

      CFG_COMPLETE:next_state = L0;

      L0:          next_state = |host_cmd ? L0 : RECOVERY;

      RECOVERY:    next_state = L0;

      default:     next_state = DETECT;

    endcase

  end



  // DMA engine : 8 canaux, 64 bits

  logic [63:0] dma_desc [8];

  assign host_status = {32'h0, state};

  assign {txp, txn} = '0; // PHY analogique hors périmètre RTL

endmodule

"""



TPL_DVFS = r"""// =====================================================================

// NEXUS DVFS — 4 phases de fréquence + power gating par cluster

// =====================================================================

`timescale 1ns/1ps

module __NAME___dvfs (

    input  wire clk, input  wire rst_n,

    input  wire [15:0] load, input  wire [7:0] temp,

    output reg  [3:0] phase,

    output reg  thermal_throttle

);

  always_ff @(posedge clk or negedge rst_n) begin

    if (!rst_n) begin phase <= 4'b0001; thermal_throttle <= 1'b0; end

    else begin

