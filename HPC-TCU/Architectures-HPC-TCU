def derive_spec(ax):

    """

    L'utilisateur pose les axiomes bruts ; le moteur déduit TOUT le reste.

    C'est la différence entre 'coder' et 'bâtir' : la conséquence émerge.

    """

    sm = max(1, int(ax.get("sm_count", 64)))

    freq_mhz = max(100, int(ax.get("freq_mhz", 1800)))

    cores_per_sm = max(4, int(ax.get("cores_per_sm", 128)))   # CUDA cores / SM

    tensor_m = max(4, int(ax.get("tensor_m", 16)))            # dims matmul array

    tensor_n = max(4, int(ax.get("tensor_n", 16)))

    tensor_k = max(4, int(ax.get("tensor_k", 16)))

    hbm_stacks = max(1, int(ax.get("hbm_stacks", 4)))

    hbm_channels = max(1, int(ax.get("hbm_channels", 8)))     # canaux par stack

    hbm_width = max(64, int(ax.get("hbm_width", 1024)))       # bits par canal

    hbm_data_rate_gts = max(1.0, float(ax.get("hbm_data_rate", 6.4)))

    noc = ax.get("noc_topology", "mesh")                      # mesh|ring|crossbar

    noc_radix = max(2, int(ax.get("noc_radix", 5)))           # ports par router

    pcie_lanes = max(8, int(ax.get("pcie_lanes", 128)))       # Gen5 x16 par port

    pcie_gen = max(3, int(ax.get("pcie_gen", 5)))

    l2_kb = max(256, int(ax.get("l2_kb", 4096)))              # par cluster

    l1_kb = max(16, int(ax.get("l1_kb", 256)))                # par SM

    clusters = max(1, int(ax.get("clusters", max(1, sm // 8))))

    process_nm = max(3, int(ax.get("process_nm", 4)))

    tdp_w = max(50, int(ax.get("tdp_w", 700)))

    has_security = bool(ax.get("security", True))

    has_dvfs = bool(ax.get("dvfs", True))



    # --- DÉRIVATIONS PHYSIQUES (Loi de Roofline) ---

    # FLOPS crête : 2 ops (mul+add) * cores * freq * (tensor boost)

    tensor_boost = (tensor_m * tensor_n * tensor_k) / (cores_per_sm * 4) if cores_per_sm else 1.0

    tensor_boost = max(1.0, min(tensor_boost, 64.0))

    tflops_fp16 = (2.0 * cores_per_sm * sm * (freq_mhz / 1000.0) * 1e-3) * tensor_boost

    tflops_fp8 = tflops_fp16 * 2.0



    # Bande passante mémoire : stacks * canaux * largeur * data_rate

    bw_tb_s = (hbm_stacks * hbm_channels * hbm_width * hbm_data_rate_gts) / 8.0 / 1000.0



    # Ridge point de Roofline = FLOPS / BW  (le régime calcul vs mémoire)

    ridge = (tflops_fp16 * 1e12) / (bw_tb_s * 1e12) if bw_tb_s > 0 else 0.0



    # Intensité arithmétique cible (op/byte) pour saturer

    ai_target = ridge



    # Efficacité énergétique (perf/W), normalisée

    perf_w = tflops_fp16 / tdp_w if tdp_w else 0.0



    # Transistors estimés (règle empirique : ~ SM * cores * 1k + HBM ctrl + NoC)

    transistors_b = (sm * cores_per_sm * 0.001) + (hbm_stacks * 0.8) + \

                    (clusters * 0.3) + (sm * 0.05) + 5.0



    # --- SCORE SYSTÉMIQUE (harmonisation Γ continu / ζ discret) ---

    # Γ : favorise le continuum mémoire (bw élevée, ridge bas = bon pour IA)

    gamma_factor = math.log1p(bw_tb_s) / math.log1p(10.0)        # 0..~1

    # ζ : favorise la structure discrète dense (cœurs, tensor, NoC radix)

    zeta_factor = math.log1p(sm * cores_per_sm * tensor_boost) / math.log1p(1e6)

    # Harmonisation : le produit géométrique punie le déséquilibre

    harmony = math.sqrt(max(0.0, gamma_factor) * max(0.0, zeta_factor))

    # Calibration par les constantes universelles

    score = round(100.0 * harmony * (1.0 + 0.1 * math.log1p(perf_w)) * ZETA_APERY / GAMMA_HALF, 1)

    score = max(0.0, min(100.0, score))



    # --- COMPARAISON FRONTALE ---

    compare = {}

    for rk, rv in REFERENCES.items():

        ref_tf = rv["tflops_fp16"]

        ref_bw = rv["bw_tb_s"]

        delta_tf = ((tflops_fp16 - ref_tf) / ref_tf * 100.0) if ref_tf else 0.0

        delta_bw = ((bw_tb_s - ref_bw) / ref_bw * 100.0) if ref_bw else 0.0

        verdict = "DOMINE" if (delta_tf > 0 and delta_bw > 0) else \

                  ("SUPÉRIEUR CALCUL" if delta_tf > 0 else \

                   ("SUPÉRIEUR MÉMOIRE" if delta_bw > 0 else "INFÉRIEUR"))

        compare[rk] = {

            "nom": rv["nom"],

            "delta_tflops_pct": round(delta_tf, 1),

            "delta_bw_pct": round(delta_bw, 1),

            "verdict": verdict,

        }



    return {

