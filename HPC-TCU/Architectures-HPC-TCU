  const c=$('viz'),x=c.getContext('2d');const W=c.width,H=c.height;

  x.clearRect(0,0,W,H);x.fillStyle='#000';x.fillRect(0,0,W,H);

  const cols=Math.ceil(Math.sqrt(s.clusters)),rows=Math.ceil(s.clusters/cols);

  const pad=30,gw=(W-pad*2)/cols,gh=(H-pad*2-30)/rows;

