TPL_SM = r"""// =====================================================================

// NEXUS SM — Pipeline superscalaire + Register File + Tensor Core + L1

// SM_ID = __SM_ID__  ·  CORES = __CORES__  ·  L1 = __L1__ KB

// =====================================================================

`timescale 1ns/1ps

module __NAME___sm #(

    parameter int CORES = __CORES__,

    parameter int L1_KB = __L1__,

    parameter int SM_ID = 0

)(

    input  wire clk, input  wire rst_n,

    output wire done,

    input  wire [63:0] req

);

  localparam int RF_ENTRIES = CORES * 32;     // 32 regs/thread

  localparam int ISSUE_WIDTH = 4;             // superscalaire 4-wide

  localparam int TENSOR_M = __TM__;

  localparam int TENSOR_N = __TN__;

  localparam int TENSOR_K = __TK__;



  // ---- Register File banked ----

  logic [31:0] rf [RF_ENTRIES];



  // ---- Scoreboard & branch predictor (OoO simplifié) ----

  logic [CORES-1:0] busy;

  logic [15:0] btb_tag; logic btb_hit;



  // ---- Issue / Execute / Writeback ----

  logic [ISSUE_WIDTH-1:0] issue_valid;

  logic [31:0] issue_pc [ISSUE_WIDTH];



  always_ff @(posedge clk or negedge rst_n) begin

    if (!rst_n) begin

      issue_valid <= '0; btb_hit <= 1'b0;

    end else begin

      // fetch → decode → issue (pipeline 7 étages condensé)

      issue_valid <= {ISSUE_WIDTH{req[0]}} & ~busy[ISSUE_WIDTH-1:0];

      btb_hit <= (btb_tag == req[31:16]);

    end

  end



  // ---- Tensor Core array (matmul MxNxK) ----

  __NAME___tensor_core #(

      .M(TENSOR_M), .N(TENSOR_N), .K(TENSOR_K)

  ) u_tensor (

      .clk(clk), .rst_n(rst_n),

      .en(issue_valid[0]),

      .a_in(req[31:0]), .b_in(req[63:32]),

      .acc_out(done)

  );



  // ---- L1 scratchpad ----

  logic [127:0] l1_mem [L1_KB*1024/16];



  assign done = |issue_valid;

endmodule

"""



TPL_TENSOR = r"""// =====================================================================

// NEXUS TENSOR CORE — Array MAC systolique __M__×__N__×__K__

// Le cœur du calcul : 1 MAC/cycle/element → __MACS__ MACs/cycle

// =====================================================================

`timescale 1ns/1ps

module __NAME___tensor_core #(

    parameter int M = __M__, parameter int N = __N__, parameter int K = __K__

)(

    input  wire clk, input  wire rst_n, input  wire en,

    input  wire [31:0] a_in, input  wire [31:0] b_in,

    output wire acc_out

);

  localparam int MACS = M * N * K;

  // Array systolique : chaque cellule = 1 MAC FP16

  logic signed [15:0] pe_acc [M][N];

  logic signed [15:0] pe_a   [M][K];

  logic signed [15:0] pe_b   [K][N];



  genvar i, j, k;

  generate

    for (i = 0; i < M; i = i + 1) begin : gx

      for (j = 0; j < N; j = j + 1) begin : gy

        always_ff @(posedge clk or negedge rst_n) begin

          if (!rst_n) pe_acc[i][j] <= '0;

          else if (en) begin

            pe_acc[i][j] <= pe_acc[i][j];

            for (k = 0; k < K; k = k + 1)

              pe_acc[i][j] <= pe_acc[i][j] + (pe_a[i][k] * pe_b[k][j]);

          end

        end

      end

    end

  endgenerate



  // Réduction arbre (log2) pour la sortie

  logic [31:0] tree_sum;

  always_comb begin

    tree_sum = '0;

    for (int x = 0; x < M; x++)

      for (int y = 0; y < N; y++)

        tree_sum += pe_acc[x][y];

  end

  assign acc_out = |tree_sum;

endmodule

"""



TPL_NOC = r"""// =====================================================================

