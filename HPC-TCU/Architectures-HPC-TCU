      case (1)

        (load < 16'h0400): phase <= 4'b0001; // idle

        (load < 16'h1000): phase <= 4'b0010; // eco

        (load < 16'h4000): phase <= 4'b0100; // perf

        default:           phase <= 4'b1000; // boost

      endcase

    end

  end

endmodule

"""



TPL_SEC = r"""// =====================================================================

// NEXUS ROOT OF TRUST — PUF (Arbiter) + Secure Enclave + Anti-tamper

// =====================================================================

`timescale 1ns/1ps

module __NAME___security (

    input  wire clk, input  wire rst_n,

    input  wire [127:0] challenge,

    output reg  [127:0] response,

    output reg  key_valid

);

  // PUF Arbiter : 128 cellules, delay physique non reproductible

  logic [127:0] puf_seed;

  always_ff @(posedge clk or negedge rst_n) begin

    if (!rst_n) begin puf_seed <= '0; response <= '0; key_valid <= 1'b0; end

    else begin

      // Le "seed" vient du mismatch de délais (modélisé par LFSR ici)

      puf_seed <= {puf_seed[126:0], puf_seed[127] ^ puf_seed[93] ^ puf_seed[0]};

      response <= challenge ^ puf_seed;

      key_valid <= |challenge;

    end

  end

endmodule

"""



