# ---- Helpers de rendu template ----

def render(tpl, mapping):

    out = tpl

    for k, v in mapping.items():

        out = out.replace("__" + k + "__", str(v))

    return out





def gen_all_rtl(spec):

    """Produit l'arbre complet de fichiers RTL + docs. Retourne dict path→contenu."""

    name = re.sub(r"[^a-zA-Z0-9_]", "_", spec.get("nom", "nexus_chip")).lower()

    d = spec["derived"]; t = spec["tensor"]; h = spec["hbm"]; n = spec["noc"]; p = spec["pcie"]

    sm = spec["sm_count"]; clusters = spec["clusters"]

    sm_per_cl = max(1, sm // clusters)

    grid = max(1, int(math.ceil(math.sqrt(clusters))))

    die = round(spec["derived"]["transistors_b"] * 12.0 + 50.0, 1)  # estimation mm²

    die_w = round(math.sqrt(die) * 1.4, 1); die_h = round(math.sqrt(die) * 0.7, 1)

    t_core = round(1000.0 / spec["freq_mhz"], 3)

    t_hbm = round(1000.0 / (h["data_rate_gts"] * 1000.0), 4)

    sec = spec["security"]; dvfs = spec["dvfs"]



    base = {

        "NAME": name, "SM": sm, "FREQ": spec["freq_mhz"], "CORES": spec["cores_per_sm"],

        "CLUSTERS": clusters, "SM_PER_CL": sm_per_cl, "L2": spec["cache"]["l2_kb"],

        "L1": spec["cache"]["l1_kb"], "HBM_S": h["stacks"], "HBM_C": h["channels"],

        "HBM_W": h["width"], "HBM_RATE": h["data_rate_gts"], "PCIE": p["lanes"],

        "PCIE_GEN": p["gen"], "RADIX": n["radix"], "TOPO": n["topology"],

        "PROC": spec["process_nm"], "TDP": spec["tdp_w"], "TM": t["m"], "TN": t["n"],

        "TK": t["k"], "TBOOST": t["boost"], "TFLOPS": d["tflops_fp16"],

        "TFLOPS8": d["tflops_fp8"], "BW": d["bw_tb_s"], "RIDGE": d["ridge_point"],

        "PERFW": d["perf_w"], "TRANS": d["transistors_b"], "DIE": die,

        "DIE_W": die_w, "DIE_H": die_h, "T_CORE": t_core, "T_HBM": t_hbm,

        "DATE": datetime.now().isoformat(timespec="seconds"), "GRID": grid,

        "MACS": t["m"]*t["n"]*t["k"],

    }



    # Top : ports & instances conditionnels

    sec_port = ",\n    output wire [127:0] sec_response,\n    output wire sec_key_valid" if sec else ""

    clk_mux = "assign clk_global = clk_core;"

    dvfs_inst = ("__NAME___dvfs u_dvfs (.clk(clk_global), .rst_n(rst_n), .load(16'h0), .temp(8'h40), .phase(dvfs_phase), .thermal_throttle(thermal_throttle));").replace("__NAME__", name) if dvfs else "assign dvfs_phase = 4'b0001; assign thermal_throttle = 1'b0;"

    sec_inst = ("__NAME___security u_sec (.clk(clk_global), .rst_n(rst_n), .challenge(host_cmd[127:0]), .response(sec_response), .key_valid(sec_key_valid));").replace("__NAME__", name) if sec else ""

    thermal_inst = "// thermal sensor intégré au die (analogique)"

    route_logic = _noc_route_logic(n["topology"], "PORTS")



    top = render(TPL_TOP, {**base, "SEC_PORT": sec_port, "CLK_MUX": clk_mux,

                           "DVFS_INST": dvfs_inst, "SEC_INST": sec_inst,

                           "THERMAL_INST": thermal_inst, "NOCK_W": "64"})

    # NOCK_W est un localparam implicite ; on le déclare via un define en tête

    top = top.replace("`default_nettype none", "`default_nettype none\n`define NOCK_W 64")

    top = top.replace("NOCK_W", "`NOCK_W")



    files = {

        f"rtl/{name}_top.sv": top,

        f"rtl/{name}_cluster.sv": render(TPL_CLUSTER, base),

        f"rtl/{name}_sm.sv": render(TPL_SM, {**base, "SM_ID": "0"}),

        f"rtl/{name}_tensor_core.sv": render(TPL_TENSOR, base),

        f"rtl/{name}_noc.sv": render(TPL_NOC, {**base, "PORTS": clusters + h["stacks"] + 1, "ROUTE_LOGIC": route_logic}),

        f"rtl/{name}_hbm_ctrl.sv": render(TPL_HBM, base),

        f"rtl/{name}_pcie.sv": render(TPL_PCIE, base),

        f"tb/tb_{name}_top.sv": render(TPL_TB, {**base, "SEC_TB": (",\n    .sec_response(sec_resp), .sec_key_valid(sec_valid)" if sec else "")}),

