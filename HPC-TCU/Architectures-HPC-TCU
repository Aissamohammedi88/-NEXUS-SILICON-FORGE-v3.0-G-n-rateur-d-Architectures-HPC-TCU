def generate_project(spec, proj_name):

    proj_name = re.sub(r"[^a-zA-Z0-9_-]", "_", proj_name) or "forge_" + str(int(datetime.now().timestamp()))

    files, chip_name = gen_all_rtl({**spec, "nom": proj_name})

    proj_dir = PROJECTS_DIR / proj_name

    proj_dir.mkdir(parents=True, exist_ok=True)

    written = []

    total_lines = 0

    for rel, content in files.items():

        full = proj_dir / rel

        full.parent.mkdir(parents=True, exist_ok=True)

        full.write_text(content, encoding="utf-8")

        nl = content.count("\n") + 1

        total_lines += nl

        written.append({"path": rel, "lines": nl, "size": len(content)})

    cfg = {"spec": spec, "chip_name": chip_name, "date": datetime.now().isoformat(),

           "author": "Aissa Mohammedi (DGK)", "total_rtl_lines": total_lines}

    (proj_dir / "forge_config.json").write_text(json.dumps(cfg, indent=2, ensure_ascii=False), encoding="utf-8")

    return proj_dir, written, total_lines, chip_name





