  logic [PORTS-1:0] route_grant;

  always_comb begin

    route_grant = '0;

    __ROUTE_LOGIC__

  end



  genvar p;

  generate

    for (p = 0; p < PORTS; p = p + 1) begin : gp

      always_ff @(posedge clk or negedge rst_n) begin

        if (!rst_n) begin fifo_wp[p] <= '0; fifo_rp[p] <= '0; end

        else begin

          if (links[p*64 +: 64] != '0 && fifo_wp[p] != FIFO_DEPTH-1)

            fifo_wp[p] <= fifo_wp[p] + 1;

          if (route_grant[p] && fifo_rp[p] != fifo_wp[p])

